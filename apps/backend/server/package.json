{
    "name": "@miaoma-doc/server",
    "version": "1.19.0",
    "author": "Heyi",
    "private": true,
    "license": "MIAOMAEDU",
    "keywords": [
        "miaoma",
        "editor",
        "typescript",
        "prosemirror",
        "wysiwyg",
        "rich-text-editor",
        "feishu",
        "notion",
        "yjs",
        "block-based",
        "tiptap",
        "nestjs",
        "server"
    ],
    "description": "Miaoma Docs backend server",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "clean": "rimraf dist",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/config/typeorm-datasource.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/config/typeorm-datasource.ts",
        "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/migrations/AutoMigration -d src/config/typeorm-datasource.ts",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --config vitest.config.mjs --exclude test/integration/**",
        "test:integration": "vitest run --config vitest.config.mjs test/integration",
        "test:unit": "vitest run --config vitest.config.mjs --exclude test/integration/**"
    },
    "dependencies": {
        "@nest-modules/mailer": "1.3.22",
        "@nestjs-modules/mailer": "2.0.2",
        "@nestjs/bull": "10.2.1",
        "@nestjs/common": "10.4.1",
        "@nestjs/config": "3.2.3",
        "@nestjs/core": "10.4.1",
        "@nestjs/jwt": "10.2.0",
        "@nestjs/passport": "10.0.3",
        "@nestjs/platform-express": "10.4.1",
        "@nestjs/platform-ws": "10.4.7",
        "@nestjs/schedule": "4.1.0",
        "@nestjs/swagger": "7.4.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "10.0.2",
        "@nestjs/websockets": "10.4.7",
        "bcryptjs": "2.4.3",
        "bull": "4.16.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.1",
        "compressing": "1.10.1",
        "helmet": "^8.1.0",
        "lib0": "0.2.98",
        "multer": "1.4.5-lts.1",
        "nanoid": "3.1.23",
        "nodemailer": "6.9.14",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "passport-local": "1.0.0",
        "pg": "8.13.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.0.1",
        "rxjs": "7.8.1",
        "swagger-ui-express": "5.0.1",
        "typeorm": "0.3.20",
        "ws": "8.18.0",
        "xml-js": "1.6.11",
        "y-postgresql": "1.0.0",
        "y-protocols": "1.0.6",
        "yjs": "13.6.20",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@nestjs/cli": "10.4.4",
        "@nestjs/schematics": "10.1.4",
        "@nestjs/testing": "^10.4.1",
        "@types/bcryptjs": "2.4.6",
        "@types/express": "4.17.21",
        "@types/node": "22.5.0",
        "pm2": "5.4.2",
        "ts-loader": "9.5.1",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0"
    }
}
