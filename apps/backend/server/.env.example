# ============================
# Miaoma Docs 后端环境变量
# ============================

# 安全
# JWT_SECRET 至少 16 字符，生产环境使用强随机字符串
JWT_SECRET=replace-with-strong-secret-at-least-16-chars

# PostgreSQL（开发环境默认使用 docker 映射端口 5433，CI/集成测试使用 5432）
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=xiaoer
PG_DATABASE=miaoma_docs
# 集成测试专用数据库（避免污染开发库）
PG_DATABASE_TEST=miaoma_test

# 服务端口
SERVER_PORT=8082

# CORS（逗号分隔多个 origin）
CORS_ORIGIN=http://localhost:5173

# 兼容 Chat Completions 的模型服务（可选；密钥仅放在服务端本地环境）
# 方舟 Coding Plan 通道：base 用 /api/coding/v3，model 直接填 model name（不需要 ep- 接入点）
AI_API_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=replace-with-rotated-key

# ============================
# 测试相关环境变量
# ============================
# 协同测试开关（设为 1 启用协同专项测试，需后端运行）
RUN_COLLAB_TESTS=0