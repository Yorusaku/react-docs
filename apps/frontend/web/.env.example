# ============================
# Miaoma Docs 前端环境变量
# ============================

# API 模式：mock（前端内置 Mock Server）或 real（直连后端）
# real 模式下 audit/governance/observability/sso/org 接口若后端未实现
# 会统一提示"后端未启用/能力未部署"，不再静默走 mock
VITE_API_MODE=mock

# WebSocket 协同编辑连接配置
VITE_WS_PROTOCOL=ws
VITE_WS_HOST=127.0.0.1
VITE_WS_PORT=8082

# WS 鉴权 token（协同测试用，需与后端 JWT_SECRET 配合）
VITE_WS_TOKEN=

# ============================
# 测试相关
# ============================
# 协同测试开关（需后端运行 + RUN_COLLAB_TESTS=1）
# VITE_RUN_COLLAB_TESTS=0
